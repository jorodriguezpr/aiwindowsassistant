# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram chat IDs allowed to use the bot.
# Leave empty on first run: send /start to the bot and it will reply with your chat ID.
TELEGRAM_ALLOWED_USERS=

# ===== AI Provider =====
# anthropic | ollama-cloud | ollama
AI_PROVIDER=anthropic
AI_MODEL=
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# Anthropic Claude
ANTHROPIC_API_KEY=

# Ollama Cloud
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com

# Local Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434

# ===== Claude Code bridge =====
# Path to the claude CLI executable (claude, claude.exe, or full path). Auto-detected from PATH if empty.
CLAUDE_CODE_PATH=
# Default workspace folder Claude Code operates in when you delegate tasks
CLAUDE_WORKSPACE=C:\PhpProjects
# Permission mode for headless runs: default | acceptEdits | plan | bypassPermissions
# bypassPermissions is required for Bash tool calls to actually run in headless mode —
# acceptEdits still makes Claude Code ask permission for Bash, which there's no TTY to
# answer, so it just declines instead of executing. The PreToolUse hook (ApprovalHookServer,
# scripts/claude-approval-hook.js) is the real safety gate and fires regardless of this mode.
CLAUDE_PERMISSION_MODE=bypassPermissions
# Max time (ms) a delegated Claude Code task may run
CLAUDE_TIMEOUT_MS=600000

# ===== Fleet Guardian escalation worker =====
# Polls SysAdminCenterHCP for "escalate to Claude Code" requests it can't push here directly
# (no inbound connectivity to this PC). Leave blank to disable — this feature no-ops without
# both values set. Get the key from the SysAdminCenterHCP Guardian settings page (admin only).
SYSADMIN_CENTER_HCP_URL=
ESCALATION_WORKER_API_KEY=
# How often to poll, in ms
ESCALATION_POLL_INTERVAL_MS=30000
# JSON map of contextRepo key -> absolute local repo path, used as cwd for escalation runs.
# Escalation runs are always read-only (scripts/claude-readonly-hook.js) regardless of this.
ESCALATION_REPO_PATHS={"sysadminhcp":"C:\\PhpProjects\\kloxo-8.0.0-25\\sysadminhcp","sysadmincenterhcp":"C:\\PhpProjects\\SysAdminCenterHCP"}

# ===== BJavaDecompiler AI delegation worker =====
# Polls BJavaDecompiler for AI reconstruction/remediation prompts (its AI_PROVIDER=ai-delegation
# setting) handed off to this desktop's Claude Code instead of Ollama/OpenAI. Leave blank to
# disable. Get the key from BJavaDecompiler's Tool Setup page (Reveal/Copy under AI Delegation
# worker setup — it's auto-generated on first request there). Unlike the Guardian escalation
# worker above, these runs never need Telegram approval — pure text reconstruction, no server
# access, no destructive tool calls — but still run read-only (scripts/claude-readonly-hook.js).
BJAVADECOMPILER_URL=
BJAVADECOMPILER_WORKER_API_KEY=
BJAVADECOMPILER_POLL_INTERVAL_MS=15000

# ===== Assistant behavior =====
# Default working directory for execute_command
DEFAULT_CWD=C:\PhpProjects
# Max agent loop iterations before asking to continue/stop
AGENT_MAX_ITERATIONS=240
# Where generate_pdf writes files. Defaults to Documents\AiWindowsAssistant if unset.
DOCUMENTS_DIR=

# ===== Email (send-only — no inbox reading) =====
# Leave EMAIL_SMTP_HOST empty to disable the send_email tool entirely.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS (port 587)
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# From address on outgoing mail. Defaults to EMAIL_SMTP_USER if unset.
EMAIL_FROM=

# ===== Autostart =====
# When true, registers a hidden launcher in HKCU Run key on startup
AUTO_START=false

# ===== Logging =====
LOG_LEVEL=info
LOG_REDACTION_DISABLED=false
