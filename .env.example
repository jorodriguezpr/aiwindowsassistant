# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram chat IDs allowed to use the bot.
# Leave empty on first run: send /start to the bot and it will reply with your chat ID.
TELEGRAM_ALLOWED_USERS=

# ===== AI Provider =====
# anthropic | ollama-cloud | ollama
AI_PROVIDER=anthropic
AI_MODEL=
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# Anthropic Claude
ANTHROPIC_API_KEY=

# Ollama Cloud
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com

# Local Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434

# ===== Claude Code bridge =====
# Path to the claude CLI executable (claude, claude.exe, or full path). Auto-detected from PATH if empty.
CLAUDE_CODE_PATH=
# Default workspace folder Claude Code operates in when you delegate tasks
CLAUDE_WORKSPACE=C:\PhpProjects
# Permission mode for headless runs: default | acceptEdits | plan | bypassPermissions
# bypassPermissions is required for Bash tool calls to actually run in headless mode —
# acceptEdits still makes Claude Code ask permission for Bash, which there's no TTY to
# answer, so it just declines instead of executing. The PreToolUse hook (ApprovalHookServer,
# scripts/claude-approval-hook.js) is the real safety gate and fires regardless of this mode.
CLAUDE_PERMISSION_MODE=bypassPermissions
# Max time (ms) a delegated Claude Code task may run
CLAUDE_TIMEOUT_MS=600000

# ===== Assistant behavior =====
# Default working directory for execute_command
DEFAULT_CWD=C:\PhpProjects
# Max agent loop iterations before asking to continue/stop
AGENT_MAX_ITERATIONS=240

# ===== Autostart =====
# When true, registers a hidden launcher in HKCU Run key on startup
AUTO_START=false

# ===== Logging =====
LOG_LEVEL=info
LOG_REDACTION_DISABLED=false
