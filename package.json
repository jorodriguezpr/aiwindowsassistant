{
  "name": "aiwindowsassistant",
  "version": "1.1.0",
  "description": "Windows 11 port of AiAgentAssistant — Telegram-controlled AI assistant with Claude Code bridge, running from the system tray",
  "main": "dist/index.js",
  "author": {
    "name": "Jose Rodriguez Arroyo",
    "email": "jrpcone@gmail.com",
    "url": "https://microrepair.net"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jorodriguezpr/aiwindowsassistant.git"
  },
  "homepage": "https://github.com/jorodriguezpr/aiwindowsassistant#readme",
  "bugs": {
    "url": "https://github.com/jorodriguezpr/aiwindowsassistant/issues"
  },
  "bin": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc && npm run icon",
    "icon": "node scripts/generate-icon.js",
    "start": "node dist/index.js",
    "postinstall": "node scripts/generate-icon.js",
    "gitdeploy": "node scripts/gitdeploy-build.js",
    "pkg-build": "node scripts/pkg-build.js"
  },
  "license": "MIT",
  "pkg": {
    "assets": ["node_modules/systray2/traybin/tray_windows_release.exe"],
    "targets": ["node22-win-x64"],
    "outputPath": "pkg-dist"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.3.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "systray2": "^2.0.5",
    "telegraf": "^4.14.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^9.0.7",
    "@yao-pkg/pkg": "^6.22.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
